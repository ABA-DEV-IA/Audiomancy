# ===================================================================
# AUDIOMANCY BACKEND - Configuration Environment Variables
# ===================================================================

# === Jamendo API ===
JAMENDO_CLIENT_ID=""  # Jamendo API client ID
JAMENDO_URL="https://api.jamendo.com/v3.0"  # Base URL for Jamendo API

# === DeepSeek LLM (remplace Azure OpenAI) ===
DEEPSEEK_API_KEY=""                          # DeepSeek API key (obligatoire)
DEEPSEEK_BASE_URL="https://api.deepseek.com" # Base URL DeepSeek
DEEPSEEK_MODEL="deepseek-chat"               # Nom du modèle
DEEPSEEK_TEMPERATURE=0.0                     # Temperature (0.0 = déterministe)
DEEPSEEK_MAX_TOKENS=512                      # Limite de tokens

# === ⚠️ DEPRECATED - azure_only_no_longer_usable_in_localhost ===
# [OBSOLÈTE] Azure OpenAI - Remplacé par DeepSeek
# ENDPOINT_URL=""        # Azure OpenAI endpoint
# DEPLOYMENT_NAME=""     # Name of deployed model
# AZURE_OPENAI_API_KEY="" # Azure OpenAI API Key

# === API Configuration ===
API_KEY=""             # FastAPI custom API key (définir votre propre clé)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"  # CORS origins
SWAGGER_ON=false       # Enable/disable Swagger UI (true/false)

# === ⚠️ DEPRECATED - azure_only_no_longer_usable_in_localhost ===
# [DÉSACTIVÉ] Azure Speech Service - TTS désactivé
# SPEECH_KEY=""          # Azure Speech API key
# SPEECH_REGION=""       # Azure region (e.g., eastus, westeurope)

# === ⚠️ DEPRECATED - azure_only_no_longer_usable_in_localhost ===
# Azure Storage & Monitoring - Remplacé par solutions locales
# AZURE_KEY_VAULT_URL=""                    # Remplacé par HashiCorp Vault (optionnel)
# AZURE_STORAGE_CONNECTION_STRING=""        # Remplacé par MongoDB cache
# CACHE_BLOB_NAME=""                        # Remplacé par MongoDB cache
# AZURE_APPINSIGHTS_CONNECTION_STRING=""    # Remplacé par Prometheus/Grafana stack

# === MongoDB ===
MONGO_HOST="localhost"                       # MongoDB host (utiliser "mongodb" dans Docker)
MONGO_PORT="27017"                           # MongoDB port
MONGO_DB_NAME="audiomancy"                   # Nom de la base de données
MONGO_USERNAME=""                            # (Optionnel) Username pour auth
MONGO_PASSWORD=""                            # (Optionnel) Password pour auth
