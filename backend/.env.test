# Test environment configuration
# These values are safe to commit as they're only used in CI/CD tests

# === API Configuration ===
API_KEY="test-api-key-for-ci"
ALLOWED_ORIGINS="http://localhost:3000"
SWAGGER_ON=false

# === MongoDB (not needed for unit tests) ===
MONGO_HOST="localhost"
MONGO_PORT="27017"
MONGO_DB_NAME="audiomancy_test"

# === Jamendo API (not needed for mocked tests) ===
JAMENDO_CLIENT_ID="test-client-id"
JAMENDO_URL="https://api.jamendo.com/v3.0"

# === DeepSeek LLM (not needed - DeepSeekClient can init without key) ===
# DEEPSEEK_API_KEY is intentionally not set to test graceful degradation
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_TEMPERATURE=0.0
DEEPSEEK_MAX_TOKENS=512
