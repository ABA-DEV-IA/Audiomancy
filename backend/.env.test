# === OpenAI / Azure LLM ===
ENDPOINT_URL="http://test"
DEPLOYMENT_NAME="test-model"
AZURE_OPENAI_API_KEY="test"
AZURE_KEY_VAULT_URL="http://test"

# === API Configuration ===
API_KEY="test"
ALLOWED_ORIGINS="*"
SWAGGER_ON=True

# === Azure Speech Service ===
