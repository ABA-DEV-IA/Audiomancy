# ===================================================================
# AUDIOMANCY FRONTEND (Next.js) - Configuration Environment Variables
# ===================================================================

# === Backend FastAPI URL ===
# En développement local
NEXT_PUBLIC_API_URL="http://localhost:8000"

# En production / Docker
# NEXT_PUBLIC_API_URL="http://backend:8000"

# Variables côté serveur Next.js uniquement (pas exposées au client)
# API Key pour sécuriser les appels depuis Next.js vers FastAPI
FASTAPI_API_KEY=""

# Note: Les variables préfixées par NEXT_PUBLIC_ sont exposées au navigateur
# Les autres variables sont uniquement accessibles côté serveur Next.js
